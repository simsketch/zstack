# zstack per-repo config. Copy to .git/zstack/config and edit by hand.
# Format: key=value, one per line. Lines starting with # are comments.

# Trust ladder per PR class:
#   L0 draft only: the agent opens a DRAFT PR labelled hold and stops; it never marks it ready, removes
#      hold or merges, and the human takes the PR over.
#   L1 open: the agent opens ready PRs with the evidence packet; the human merges.
#   L2 merge on evidence: the agent merges its own PRs that pass every gate, one at a time.
#   L3 batch: the agent merges area batches (needs zstack-fleet and L3 for every class in the batch).
# Only the human raises a level. solo is capped at L1 whatever is written here.
trust.docs=L1
trust.tests=L1
trust.small-ui=L1
trust.feature=L1
trust.solo=L0

# Date a level was last set or restored (ISO). A revert in that class after this date drops it one level.
# With no date, any revert in the class drops it.
# trust.docs.since=2026-11-01

# Sibling repos that bug-class-sweep also searches, space separated.
sweep_repos=

# Command used to send the human one short message when the decision page changes. Empty means none.
# This per-repo key is what core playbooks use. When it is empty and zstack-fleet is installed, they fall
# back to fleet's notify.sh, which reads notify_cmd from ~/.config/zstack/config (the machine key fleet's
# own scripts always use). With neither set, the message goes in the session reply.
notify_cmd=

# Base branch PRs target.
base=main
